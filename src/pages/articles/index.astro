---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/siteConfig";
import { getAllPosts, getAllCategories, formatPostDate } from "../../lib/blog";

const posts = await getAllPosts();
const categories = getAllCategories(posts);
---

<BaseLayout
  title={`Articles | ${siteConfig.publicationName}`}
  description="Read campus news, columns, editorials, features, and research from The Watch Guild, the official student publication of PECIT."
  schema="Organization"
>
  <section class="bg-surface-alt border-b border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
      <nav class="text-sm text-text-muted mb-3">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-text">Articles</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-bold text-primary">Press Releases</h1>
      <p class="mt-3 text-text-muted max-w-2xl">
        Official stories, columns, and campus news from {siteConfig.publicationName}.
      </p>
    </div>
  </section>

  <section class="py-10 sm:py-14 bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
        <div class="lg:col-span-8">
          <div class="flex flex-wrap gap-2 mb-8" id="category-filters" role="tablist" aria-label="Filter by category">
            <button
              type="button"
              data-category="all"
              class="filter-btn rounded-md px-3 py-1.5 text-xs font-bold uppercase tracking-wide bg-primary text-white"
            >
              All
            </button>
            {categories.map((cat) => (
              <button
                type="button"
                data-category={cat}
                class="filter-btn rounded-md px-3 py-1.5 text-xs font-bold uppercase tracking-wide bg-surface-alt text-text-muted border border-border hover:border-primary/40 hover:text-primary transition-colors"
              >
                {cat}
              </button>
            ))}
          </div>

          <div id="articles-list" class="divide-y divide-border border-t border-border">
            {posts.map((post) => (
              <article
                class="article-item py-8 first:pt-6 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-start"
                data-categories={post.data.tags.join("|").toLowerCase()}
              >
                <!-- Image column (CSU: image | details) -->
                <a
                  href={`/articles/${post.id}/`}
                  class="md:col-span-5 lg:col-span-4 block overflow-hidden rounded-lg border border-border bg-surface-alt aspect-[4/3] group"
                >
                  {post.data.image ? (
                    <img
                      src={post.data.image}
                      alt=""
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-primary/5 text-primary font-bold text-lg">
                      The Watch Guild
                    </div>
                  )}
                </a>

                <!-- Details column -->
                <div class="md:col-span-7 lg:col-span-8 min-w-0 flex flex-col">
                  <h2 class="text-xl sm:text-2xl font-bold text-primary leading-snug">
                    <a href={`/articles/${post.id}/`} class="hover:text-primary-dark transition-colors">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="mt-3 text-sm text-text-muted">
                    <span class="text-text-muted">by:</span>{" "}
                    <span class="font-semibold text-text">{post.data.author}</span>
                    {" "}
                    {formatPostDate(post.data.date)}
                  </p>
                  {post.data.tags[0] && (
                    <p class="mt-1 text-[0.65rem] font-bold uppercase tracking-wide text-accent">
                      {post.data.tags[0]}
                    </p>
                  )}
                  <p class="mt-4 text-text leading-relaxed line-clamp-4">{post.data.description}</p>
                  <a
                    href={`/articles/${post.id}/`}
                    class="mt-auto pt-4 inline-flex items-center text-sm font-semibold text-primary hover:text-primary-dark transition-colors"
                  >
                    Read more
                    <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>

          <p id="no-results" class="hidden text-center text-text-muted py-12">
            No articles in this category yet.
          </p>
        </div>

        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-24 rounded-xl border border-border bg-surface-alt overflow-hidden shadow-card">
            <div class="bg-primary px-5 py-4">
              <h2 class="text-base font-bold text-white">Quick Links</h2>
            </div>
            <nav class="p-2">
              <a href="/research/" class="block px-4 py-3 text-sm font-medium text-text hover:bg-primary/5 hover:text-primary rounded-lg transition-colors">
                Scholarly Works
              </a>
              <a href="/research/kahayag/" class="block px-4 py-3 text-sm font-medium text-text hover:bg-primary/5 hover:text-primary rounded-lg transition-colors">
                Kahayag Journal
              </a>
              <a href="/handbook/" class="block px-4 py-3 text-sm font-medium text-text hover:bg-primary/5 hover:text-primary rounded-lg transition-colors">
                Student Handbook
              </a>
              <a href="/journalists/" class="block px-4 py-3 text-sm font-medium text-text hover:bg-primary/5 hover:text-primary rounded-lg transition-colors">
                Meet the Guild
              </a>
              <a href="/contact/" class="block px-4 py-3 text-sm font-medium text-text hover:bg-primary/5 hover:text-primary rounded-lg transition-colors">
                Contact Us
              </a>
            </nav>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const items = document.querySelectorAll<HTMLElement>(".article-item");
  const noResults = document.getElementById("no-results");
  const list = document.getElementById("articles-list");

  function setActive(btn: HTMLButtonElement) {
    buttons.forEach((b) => {
      const active = b === btn;
      b.classList.toggle("bg-primary", active);
      b.classList.toggle("text-white", active);
      b.classList.toggle("border", !active);
      b.classList.toggle("border-border", !active);
      b.classList.toggle("bg-surface-alt", !active);
      b.classList.toggle("text-text-muted", !active);
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const cat = btn.dataset.category?.toLowerCase() ?? "all";
      setActive(btn);
      let visible = 0;
      items.forEach((el) => {
        const cats = el.dataset.categories ?? "";
        const show = cat === "all" || cats.includes(cat.toLowerCase());
        el.classList.toggle("hidden", !show);
        if (show) visible++;
      });
      noResults?.classList.toggle("hidden", visible > 0);
      list?.classList.toggle("hidden", visible === 0);
    });
  });
</script>
