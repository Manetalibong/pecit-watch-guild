---
import { withBase } from "../../lib/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/siteConfig";
import { getCollection, render } from "astro:content";
import { formatPostDate } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, metaTitle, metaDescription, image, author, date, tags } = post.data;

const formattedDate = formatPostDate(date);
const isoDate = date.toISOString().split("T")[0];

const allPosts = (await getCollection("blog"))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const sidebarPosts = allPosts.slice(0, 8);
---

<BaseLayout
  title={metaTitle || `${title} | ${siteConfig.publicationName}`}
  description={metaDescription || description}
  image={image}
  type="article"
  schema="Article"
  articleTitle={title}
  articleDate={date.toISOString()}
  articleAuthor={author}
>
  <div class="bg-surface border-b border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <nav class="text-sm text-text-muted">
        <a href={withBase("/")} class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href={withBase("/articles/")} class="hover:text-primary transition-colors">Articles</a>
      </nav>

      <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
        <!-- Main column â€” CSU press release style -->
        <article class="lg:col-span-8 min-w-0">
          <h1 class="text-2xl sm:text-3xl lg:text-[2rem] font-bold text-primary leading-snug">
            {title}
          </h1>

          <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-text-muted">
            <span class="font-semibold text-text">{author}</span>
            <span class="text-border" aria-hidden="true">|</span>
            <time datetime={isoDate}>{formattedDate}</time>
            {tags.length > 0 && (
              <>
                <span class="text-border" aria-hidden="true">|</span>
                <span class="inline-flex flex-wrap gap-2">
                  {tags.map((tag) => (
                    <a
                      href={withBase(`/articles/?category=${encodeURIComponent(tag.toLowerCase().replace(/\s+/g, "-"))}`)}
                      class="font-semibold uppercase tracking-wide text-[0.7rem] text-accent hover:text-primary transition-colors"
                    >
                      {tag}
                    </a>
                  ))}
                </span>
              </>
            )}
          </div>

          {image && (
            <figure class="mt-8">
              <img
                src={image ? withBase(image) : image}
                alt=""
                class="w-full rounded-lg border border-border object-cover max-h-[480px]"
                loading="eager"
                fetchpriority="high"
              />
            </figure>
          )}

          <div
            class="article-prose mt-8 prose prose-lg max-w-none
              prose-headings:text-primary prose-headings:font-bold
              prose-p:text-text prose-p:leading-[1.75]
              prose-li:text-text prose-strong:text-text
              prose-a:text-primary prose-a:underline-offset-2 hover:prose-a:text-primary-dark
              prose-img:rounded-lg prose-img:border prose-img:border-border"
          >
            <Content />
          </div>

          <div class="mt-12 pt-6 border-t border-border flex flex-wrap items-center justify-between gap-4">
            <a
              href={withBase("/articles/")}
              class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary-dark transition-colors"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
              Back to Articles
            </a>
            <p class="text-xs text-text-muted">
              {siteConfig.publicationName} Â· {siteConfig.institutionShort}
            </p>
          </div>
        </article>

        <!-- Sidebar â€” Press Releases (CSU-style) -->
        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-24 rounded-xl border border-border bg-surface-alt overflow-hidden shadow-card">
            <div class="bg-primary px-5 py-4">
              <h2 class="text-base font-bold text-white">Press Releases</h2>
              <p class="text-xs text-white/70 mt-0.5">Latest from The Watch Guild</p>
            </div>
            <ul class="divide-y divide-border max-h-[70vh] overflow-y-auto">
              {sidebarPosts.map((item) => (
                <li>
                  <a
                    href={withBase(`/articles/${item.id}/`)}
                    class:list={[
                      "block px-5 py-4 hover:bg-primary/[0.04] transition-colors group",
                      item.id === post.id && "bg-primary/[0.06]",
                    ]}
                  >
                    <h3 class="text-sm font-semibold text-text leading-snug group-hover:text-primary transition-colors line-clamp-3">
                      {item.data.title}
                    </h3>
                    <p class="mt-2 text-xs text-text-muted">
                      <span class="font-medium text-text/80">{item.data.author}</span>
                      {" "}
                      {formatPostDate(item.data.date)}
                    </p>
                    {item.data.tags[0] && (
                      <p class="mt-1 text-[0.65rem] font-bold uppercase tracking-wide text-accent">
                        {item.data.tags[0]}
                      </p>
                    )}
                  </a>
                </li>
              ))}
            </ul>
            <div class="border-t border-border px-5 py-3 bg-surface">
              <a
                href={withBase("/articles/")}
                class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors"
              >
                View all articles â†’
              </a>
            </div>
          </div>

          <div class="mt-6 rounded-xl border border-border bg-surface p-5 shadow-card">
            <p class="text-sm font-bold text-text">Join The Watch Guild</p>
            <p class="mt-2 text-sm text-text-muted leading-relaxed">
              Write for campus. Report with integrity. Be part of PECIT's official publication.
            </p>
            <a
              href={withBase("/contact/")}
              class="mt-4 inline-flex w-full items-center justify-center rounded-lg bg-primary px-4 py-2.5 text-sm font-bold text-white hover:bg-primary-dark transition-colors"
            >
              Contact us
            </a>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .article-prose :global(p) {
    margin-top: 1.25em;
    margin-bottom: 1.25em;
  }
  .article-prose :global(p:first-child) {
    margin-top: 0;
  }
  .article-prose :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
