---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationReader from "../../components/PublicationReader.astro";
import { getPublication } from "../../data/publications";
import { siteConfig } from "../../config/siteConfig";

const pub = getPublication("kahayag")!;
---

<BaseLayout
  title={`${pub.title} | ${siteConfig.businessName}`}
  description={pub.description ?? pub.title}
  schema="Organization"
>
  <PublicationReader pub={pub} />
</BaseLayout>
