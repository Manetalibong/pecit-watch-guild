---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import JoinGuildCTA from "../../components/JoinGuildCTA.astro";
import Icon from "../../components/Icon.astro";
import { siteConfig } from "../../config/siteConfig";
import { editorialBoard, guildStaff, joinHighlights } from "../../data/guild";
---

<BaseLayout
  title={`Journalists & Editorial Board | ${siteConfig.publicationName}`}
  description="Meet The Watch Guild editorial board and learn how to join the official student publication of PECIT."
  schema="Organization"
>
  <PageHero
    eyebrow="Editorial board"
    title="Meet the Guild"
    description="The minds behind the words — student journalists who bring PECIT stories to life."
    align="center"
  />

  <section class="py-16 sm:py-20 bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 lg:gap-12">
        {editorialBoard.map((member) => (
          <article class="group text-center">
            <div class="mx-auto w-44 h-44 sm:w-52 sm:h-52 overflow-hidden rounded-full ring-4 ring-primary/15 group-hover:ring-primary/35 shadow-card group-hover:shadow-card-hover transition-all">
              <img
                src={member.image}
                alt={member.name}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <h2 class="mt-6 text-xl font-bold text-text">{member.name}</h2>
            <p class="mt-1 text-sm font-semibold text-accent">{member.role}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-16 bg-surface-alt border-y border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="eyebrow text-accent">The team</p>
        <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-text">Writers, visuals &amp; design</h2>
        <p class="mt-3 text-text-muted">
          Beyond the editorial board, staff contributors cover beats across campus — from sports and research to culture
          and student life.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {guildStaff.map((member) => (
          <div class="rounded-2xl overflow-hidden border border-border bg-surface shadow-card card-lift">
            <img src={member.image} alt="" class="h-40 w-full object-cover" loading="lazy" />
            <div class="p-5">
              <h3 class="font-bold text-text">{member.name}</h3>
              <p class="text-sm text-text-muted mt-1">{member.role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="eyebrow text-primary">How to join</p>
          <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-text">Be part of a growing family</h2>
          <p class="mt-4 text-text-muted leading-relaxed">
            Whether you are an aspiring journalist, photographer, designer, or someone with a fresh perspective — we want
            you on The Watch Guild team.
          </p>
          <ul class="mt-8 space-y-4">
            {joinHighlights.map((item) => (
              <li class="flex gap-3 text-sm text-text-muted">
                <Icon name="check" class="h-5 w-5 text-primary shrink-0" strokeWidth={2.5} />
                {item}
              </li>
            ))}
          </ul>
          <a
            href="/contact/"
            class="mt-8 inline-flex rounded-xl bg-primary px-6 py-3.5 text-sm font-bold text-white shadow-card hover:bg-primary-dark transition-all"
          >
            Inquire about joining
          </a>
        </div>
        <img
          src="/images/about-guild.jpg"
          alt="Watch Guild team at work"
          class="rounded-2xl shadow-panel aspect-[4/3] object-cover ring-1 ring-border"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <JoinGuildCTA
    title="Ready to tell PECIT's stories?"
    subtitle="Reach out through our contact page or visit the publication office on campus."
  />
</BaseLayout>
