---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import JoinGuildCTA from "../components/JoinGuildCTA.astro";
import { siteConfig } from "../config/siteConfig";
import { editorialPillars } from "../data/homepage";
import { withBase } from "../lib/paths";

const programs = [
  "Business Administration",
  "Information Systems",
  "Hospitality and Tourism",
  "Criminology",
];
---

<BaseLayout
  title={`About Us | ${siteConfig.publicationName}`}
  description={`${siteConfig.mission} Learn about ${siteConfig.publicationName} and ${siteConfig.institutionShort}.`}
  schema="Organization"
>
  <PageHero
    eyebrow="About Us"
    title="Welcome to The Watch Guild Publication"
    description={`The official student publication of ${siteConfig.institution}. We inform, inspire, and engage the PECIT community through student journalism.`}
  />

  <section class="py-16 sm:py-20 bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <p class="eyebrow text-accent">Our story</p>
          <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-text">More than a school paper</h2>
          <p class="mt-4 text-text-muted leading-relaxed">
            At <strong class="text-text font-semibold">The Watch Guild</strong>, we are a collective of student writers,
            editors, photographers, and creatives. Every article we publish reflects the curiosity, talent, and dedication
            of our team — from breaking campus news to research features and opinion columns.
          </p>
          <p class="mt-4 text-text-muted leading-relaxed">{siteConfig.mission}</p>
          <ul class="mt-8 space-y-3">
            {[
              "Keep our community updated on events and campus life.",
              "Share perspectives that spark dialogue and critical thinking.",
              "Uphold press freedom and truthful reporting on campus.",
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-text-muted">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/10 mt-0.5">
                  <Icon name="check" class="h-3.5 w-3.5 text-primary" strokeWidth={3} />
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="relative">
          <img
            src={withBase("/images/team-photo.jpg")}
            alt="The Watch Guild editorial board at PECIT"
            class="rounded-2xl shadow-panel w-full aspect-[4/3] object-cover object-top ring-1 ring-border"
            loading="eager"
          />
          <div class="absolute bottom-0 left-0 right-0 rounded-b-2xl bg-gradient-to-t from-surface-dark via-surface-dark/85 to-transparent px-6 pt-12 pb-5">
            <p class="text-sm font-bold text-white">The Watch Guild Editorial Board</p>
            <p class="text-xs text-white/75 mt-1">{siteConfig.tagline}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-primary relative overflow-hidden pattern-grid">
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="eyebrow text-white/65">Editorial promise</p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-bold text-white">{siteConfig.motto}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {editorialPillars.map((pillar) => (
          <div class="rounded-2xl bg-white/[0.08] border border-white/15 p-7 sm:p-8 text-center shadow-panel">
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-white/15 ring-1 ring-white/25">
              <Icon name={pillar.icon} class="h-7 w-7 text-white" />
            </div>
            <h3 class="text-xl font-bold text-white">{pillar.title}</h3>
            <p class="mt-3 text-sm text-white/75 leading-relaxed">{pillar.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="institution" class="py-16 sm:py-20 bg-surface-alt scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <img
            src={withBase("/images/hero-campus.jpg")}
            alt="PECIT campus and community"
            class="rounded-2xl shadow-card w-full aspect-[16/10] object-cover ring-1 ring-border"
            loading="lazy"
          />
        </div>
        <div class="order-1 lg:order-2">
          <p class="eyebrow text-primary">Our institution</p>
          <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-text">{siteConfig.institution}</h2>
          <p class="mt-4 text-text-muted leading-relaxed">
            At PECIT, education transforms lives and uplifts communities. We foster a campus culture where curiosity is
            encouraged, creativity is celebrated, and students are empowered to lead with purpose.
          </p>
          <p class="mt-4 text-text-muted leading-relaxed">
            Programs connect theory with hands-on experience — preparing students for fast-changing industries across
            Caraga and beyond.
          </p>
          <div class="mt-8 flex flex-wrap gap-2">
            {programs.map((p) => (
              <span class="rounded-full bg-primary/8 text-primary text-xs font-semibold px-3.5 py-1.5 ring-1 ring-primary/15">
                {p}
              </span>
            ))}
          </div>
          <a
            href={withBase("/articles/education-butuan-city-philippines-pecit/")}
            class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary-dark transition-colors"
          >
            Read: PECIT in Butuan City
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <JoinGuildCTA />
</BaseLayout>
