---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PublicationContactForm from "../components/PublicationContactForm.astro";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../config/siteConfig";
---

<BaseLayout
  title={`Contact Us | ${siteConfig.publicationName}`}
  description={`Contact ${siteConfig.publicationName}. Email ${siteConfig.email} or visit us in Butuan City.`}
  schema="Organization"
>
  <PageHero
    eyebrow="Get in touch"
    title="Contact The Watch Guild"
    description="Story tips, partnership inquiries, or questions about joining the publication — we'd love to hear from you."
  />

  <section class="py-16 sm:py-20 bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-7">
          <div class="rounded-2xl border border-border bg-surface-alt p-6 sm:p-8 shadow-card">
            <h2 class="text-xl font-bold text-text mb-1">Send a message</h2>
            <p class="text-sm text-text-muted mb-6">
              Fill out the form and our editorial team will get back to you as soon as we can.
            </p>
            <PublicationContactForm />
          </div>
        </div>

        <div class="lg:col-span-5 space-y-6">
          <div class="rounded-2xl bg-primary text-white p-6 sm:p-8 shadow-panel pattern-grid relative overflow-hidden">
            <div class="absolute inset-0 bg-logo-gradient opacity-20 pointer-events-none" aria-hidden="true"></div>
            <div class="relative">
              <p class="eyebrow text-white/65">Direct contact</p>
              <h2 class="mt-2 text-xl font-bold">{siteConfig.publicationName}</h2>
              <p class="mt-2 text-sm text-white/75">{siteConfig.tagline}</p>
            </div>
          </div>

          {
            [
              {
                label: "Email",
                value: siteConfig.email,
                href: `mailto:${siteConfig.email}`,
                icon: "mail",
              },
              {
                label: "Phone",
                value: siteConfig.phone,
                href: `tel:${siteConfig.phone.replace(/\D/g, "")}`,
                icon: "phone",
              },
              {
                label: "Address",
                value: `${siteConfig.address.street}, ${siteConfig.address.city}, ${siteConfig.address.state}`,
                icon: "map-pin",
              },
            ].map((item) => (
              <div class="flex gap-4 rounded-xl border border-border bg-surface-alt p-5 shadow-card">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <Icon name={item.icon} class="h-5 w-5" />
                </span>
                <div>
                  <h3 class="text-sm font-bold text-text">{item.label}</h3>
                  {item.href ? (
                    <a href={item.href} class="mt-1 block text-sm text-text-muted hover:text-primary transition-colors">
                      {item.value}
                    </a>
                  ) : (
                    <p class="mt-1 text-sm text-text-muted">{item.value}</p>
                  )}
                </div>
              </div>
            ))
          }

          <div class="rounded-xl border border-border p-5">
            <h3 class="text-sm font-bold text-text">Follow us</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {
                Object.entries(siteConfig.socialLinks)
                  .filter(([, url]) => url)
                  .map(([network, url]) => (
                    <a
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-lg bg-primary/8 px-3 py-1.5 text-xs font-semibold text-primary capitalize hover:bg-primary hover:text-white transition-colors"
                    >
                      {network}
                    </a>
                  ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
