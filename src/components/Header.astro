---
import { siteConfig } from "../config/siteConfig";
import { mainNav } from "../config/navigation";
import { withBase } from "../lib/paths";

const basePrefix = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
const rawPath = Astro.url.pathname;
const currentPath =
  basePrefix && rawPath.startsWith(basePrefix)
    ? rawPath.slice(basePrefix.length) || "/"
    : rawPath;
const { socialLinks } = siteConfig;
const logoSrc = withBase(siteConfig.logo);
const homeHref = withBase("/");

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/" || currentPath === "";
  const clean = href.split("?")[0];
  return currentPath === clean || currentPath.startsWith(clean);
}

function navHref(href: string): string {
  return withBase(href);
}
---

<header class="sticky top-0 z-50">
  <!-- Utility bar -->
  <div class="bg-primary-dark text-white text-xs sm:text-sm">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex items-center justify-between h-9">
      <p class="hidden sm:block truncate opacity-90">
        {siteConfig.institutionShort} · {siteConfig.tagline}
      </p>
      <div class="flex items-center gap-4 ml-auto">
        <a href={`mailto:${siteConfig.email}`} class="hover:text-secondary-light transition-colors truncate">
          {siteConfig.email}
        </a>
        <div class="flex items-center gap-2">
          {socialLinks.facebook && (
            <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="opacity-80 hover:opacity-100 transition-opacity">
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          )}
          {socialLinks.youtube && (
            <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="opacity-80 hover:opacity-100 transition-opacity">
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          )}
          {socialLinks.twitter && (
            <a href={socialLinks.twitter} target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="opacity-80 hover:opacity-100 transition-opacity">
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Main nav -->
  <div class="bg-surface/95 backdrop-blur border-b border-border shadow-card">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between lg:h-20">
        <a href={homeHref} class="flex items-center gap-3 shrink-0">
          <img
            src={logoSrc}
            alt={siteConfig.publicationName}
            class="h-10 sm:h-12 w-auto"
            width="180"
            height="48"
          />
        </a>

        <!-- Desktop Nav (CSU-style dropdowns; Research uses wider panel) -->
        <nav class="hidden lg:flex items-center gap-0.5">
          {mainNav.map((item) => (
            item.children ? (
              <div class="relative group">
                <a
                  href={navHref(item.href)}
                  class:list={[
                    "inline-flex items-center gap-1 px-3 py-2 rounded-md text-sm font-medium transition-colors",
                    isActive(item.href)
                      ? "text-primary bg-primary/5"
                      : "text-text-muted hover:text-primary hover:bg-primary/5",
                  ]}
                >
                  {item.label}
                  <svg class="h-4 w-4 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>
                <div class="absolute left-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                  {item.label === "Research" ? (
                    <div class="w-[420px] rounded-2xl border border-border bg-surface p-3 shadow-panel">
                      <p class="px-3 py-2 text-xs font-bold uppercase tracking-widest text-primary">Research Menu</p>
                      <div class="grid grid-cols-1 gap-1">
                        {item.children.map((child) => (
                          <a
                            href={navHref(child.href)}
                            class="rounded-lg px-3 py-2.5 hover:bg-primary/5 transition-colors group/item"
                          >
                            <span class="block text-sm font-semibold text-text group-hover/item:text-primary">
                              {child.label}
                            </span>
                            {child.description && (
                              <span class="mt-0.5 block text-xs text-text-muted leading-snug">
                                {child.description}
                              </span>
                            )}
                          </a>
                        ))}
                      </div>
                    </div>
                  ) : (
                    <div class="min-w-[220px] rounded-xl border border-border bg-surface py-2 shadow-panel">
                      {item.children.map((child) => (
                        <a
                          href={navHref(child.href)}
                          class="block px-4 py-2 text-sm text-text-muted hover:text-primary hover:bg-primary/5 transition-colors"
                        >
                          {child.label}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            ) : (
              <a
                href={navHref(item.href)}
                class:list={[
                  "px-3 py-2 rounded-md text-sm font-medium transition-colors",
                  isActive(item.href)
                    ? "text-primary bg-primary/5"
                    : "text-text-muted hover:text-primary hover:bg-primary/5",
                ]}
              >
                {item.label}
              </a>
            )
          ))}
        </nav>

        <div class="flex items-center gap-3">
          <a
            href={navHref("/contact/")}
            class="hidden sm:inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-white shadow-card hover:bg-primary-dark hover:shadow-card-hover transition-all"
          >
            Join the Guild
          </a>

          <button
            id="mobile-menu-btn"
            class="lg:hidden inline-flex items-center justify-center rounded-md p-2 text-text-muted hover:text-primary hover:bg-primary/5 transition-colors"
            aria-label="Open navigation menu"
            aria-expanded="false"
          >
            <svg id="menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-border bg-surface">
    <nav class="mx-auto max-w-7xl px-4 py-4 space-y-1">
      {mainNav.map((item) => (
        <>
          <a
            href={navHref(item.href)}
            class:list={[
              "block px-3 py-2.5 rounded-md text-base font-medium transition-colors",
              isActive(item.href)
                ? "text-primary bg-primary/5"
                : "text-text-muted hover:text-primary hover:bg-primary/5",
            ]}
          >
            {item.label}
          </a>
          {item.children?.map((child) => (
            <a
              href={navHref(child.href)}
              class="block px-6 py-2.5 hover:bg-primary/5 rounded-md transition-colors"
            >
              <span class="block text-sm text-text-muted hover:text-primary">{child.label}</span>
              {child.description && item.label === "Research" && (
                <span class="block text-xs text-text-muted/80 mt-0.5">{child.description}</span>
              )}
            </a>
          ))}
        </>
      ))}
      <a
        href={navHref("/contact/")}
        class="block mt-3 text-center rounded-xl bg-primary px-4 py-3.5 text-base font-bold text-white shadow-card hover:bg-primary-dark transition-colors"
      >
        Join the Guild
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  btn?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(isOpen));
    iconOpen?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
  });
</script>
