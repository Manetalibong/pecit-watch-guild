---
interface Props {
  pdfSrc: string;
  remoteUrl?: string;
  title: string;
  subtitle?: string;
  backHref?: string;
  backLabel?: string;
}

const { pdfSrc, remoteUrl, title, subtitle, backHref = "/", backLabel = "Back to home" } = Astro.props;
---

<div
  class="pdf-flipbook-root flex flex-col bg-[#1a1a22] text-white min-h-[calc(100vh-4rem)] lg:min-h-[calc(100vh-5rem)]"
  data-pdf-flipbook-root
  data-pdf-src={pdfSrc}
  data-pdf-remote={remoteUrl}
  data-title={title}
>
  <!-- Toolbar (title + controls) -->
  <div class="shrink-0 border-b border-white/10 bg-primary">
    <div class="mx-auto max-w-7xl px-3 py-2.5 sm:px-4 sm:py-3">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4 border-b border-white/10 pb-2.5 mb-2.5 sm:border-0 sm:pb-0 sm:mb-0">
        <div class="min-w-0 flex-1">
          <a
            href={backHref}
            class="text-xs font-medium text-white/75 hover:text-white transition-colors"
          >
            ← {backLabel}
          </a>
          <h1 class="mt-0.5 truncate text-base font-bold text-white sm:text-lg">{title}</h1>
          {subtitle && <p class="truncate text-xs text-white/65">{subtitle}</p>}
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <div class="flex items-center gap-1 rounded-lg bg-black/20 p-0.5">
          <button
            type="button"
            data-mode-flip
            class="rounded-md px-3 py-1.5 text-xs font-semibold bg-white/15 transition-colors hover:bg-white/20"
          >
            Flipbook
          </button>
          <button
            type="button"
            data-mode-scroll
            class="rounded-md px-3 py-1.5 text-xs font-semibold transition-colors hover:bg-white/20"
          >
            Scroll
          </button>
        </div>

        <div class="flex items-center gap-1">
          <button
            type="button"
            data-action-prev
            class="rounded-lg p-2 hover:bg-white/10 transition-colors"
            aria-label="Previous page"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            type="button"
            data-action-next
            class="rounded-lg p-2 hover:bg-white/10 transition-colors"
            aria-label="Next page"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

        <div class="flex items-center gap-2 text-sm">
          <span data-page-label class="hidden sm:inline text-white/80">Loading…</span>
          <label class="flex items-center gap-1 text-white/70">
            <span class="sr-only">Page</span>
            <input
              data-page-input
              type="number"
              min="1"
              value="1"
              class="w-14 rounded-md border border-white/20 bg-black/30 px-2 py-1 text-center text-sm text-white"
            />
            <span>/ <span data-page-total>—</span></span>
          </label>
        </div>

        <div class="flex flex-wrap items-center gap-1 sm:ml-auto">
          <button type="button" data-action-thumbs class="rounded-lg px-3 py-1.5 text-xs font-medium hover:bg-white/10">
            Thumbnails
          </button>
          <button type="button" data-action-zoom-out class="rounded-lg p-2 hover:bg-white/10 hidden sm:block" aria-label="Zoom out">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M20 12H4" /></svg>
          </button>
          <button type="button" data-action-zoom-in class="rounded-lg p-2 hover:bg-white/10 hidden sm:block" aria-label="Zoom in">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 4v16M4 12h16" /></svg>
          </button>
          <button type="button" data-action-fullscreen class="rounded-lg p-2 hover:bg-white/10" aria-label="Fullscreen">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5" />
            </svg>
          </button>
          <a
            data-action-download
            href={pdfSrc}
            download
            class="rounded-lg bg-white/10 px-3 py-1.5 text-xs font-semibold hover:bg-white/20 transition-colors"
          >
            Download PDF
          </a>
        </div>
      </div>
    </div>
  </div>

  <div data-thumb-panel class="hidden shrink-0 border-b border-white/10 bg-[#121218] max-h-36 overflow-y-auto overscroll-contain">
    <div data-thumb-grid class="flex gap-2 p-3"></div>
  </div>

  <div data-stage class="relative flex-1 min-h-0 overflow-hidden">
    <div
      data-loading
      class="absolute inset-0 z-20 flex flex-col items-center justify-center gap-4 bg-[#1a1a22]"
    >
      <p class="text-sm text-white/70" data-loading-text>Loading document…</p>
      <div class="h-1.5 w-64 max-w-[80%] overflow-hidden rounded-full bg-white/10">
        <div data-loading-bar class="h-full w-0 rounded-full bg-secondary transition-[width] duration-300"></div>
      </div>
      <p class="text-xs text-white/45 max-w-md text-center px-4">
        Drag page corners to flip · Arrow keys · Scroll mode for long documents
      </p>
    </div>

    <div data-book-host class="h-full w-full overflow-y-auto overflow-x-hidden py-6 px-2 flex items-start justify-center"></div>

    <div
      data-scroll-host
      class="hidden h-full min-h-0 overflow-y-auto overflow-x-hidden overscroll-y-contain py-4 px-4"
      style="touch-action: pan-y; -webkit-overflow-scrolling: touch;"
    >
      <div data-scroll-inner class="pdf-scroll-inner mx-auto max-w-3xl"></div>
    </div>
  </div>
</div>

<style is:global>
  /* These elements are created in JS, so styles must be global (not scoped). */
  .pdf-flip-book {
    margin: 0 auto;
    touch-action: manipulation;
  }
  .pdf-flip-book .page {
    background: #fff;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }
  .pdf-flip-book .page .page-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fff;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }
  .pdf-scroll-inner .pdf-scroll-page {
    content-visibility: auto;
    contain-intrinsic-size: auto 900px;
  }
</style>

<script>
  import { initAllPdfFlipbooks } from "../lib/pdf-flipbook";
  initAllPdfFlipbooks();
</script>
