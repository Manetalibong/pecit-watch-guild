---
import type { Article } from "../types/article";
import { formatArticleDate, getPrimaryCategory } from "../lib/articles";

interface Props {
  article: Article;
  variant?: "default" | "featured" | "compact" | "horizontal";
}

const { article, variant = "default" } = Astro.props;
const category = getPrimaryCategory(article);
const href = `/articles/${article.slug}/`;
---

{variant === "featured" && (
  <article class="group relative overflow-hidden rounded-2xl bg-surface-dark shadow-xl">
    <a href={href} class="block">
      <div class="relative aspect-[16/10] overflow-hidden">
        {article.image ? (
          <img
            src={article.image}
            alt={article.title}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center bg-primary/20">
            <span class="text-4xl font-bold text-white/30">TWG</span>
          </div>
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-surface-dark via-surface-dark/60 to-transparent" />
      </div>
      <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
        <span class="inline-block rounded-full bg-secondary px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">
          {category}
        </span>
        <h3 class="mt-3 text-xl sm:text-2xl lg:text-3xl font-bold text-white leading-tight group-hover:text-secondary-light transition-colors">
          {article.title}
        </h3>
        <p class="mt-2 text-sm text-gray-300 line-clamp-2">{article.excerpt}</p>
        <p class="mt-3 text-xs text-gray-400">{formatArticleDate(article.date)}</p>
      </div>
    </a>
  </article>
)}

{variant === "horizontal" && (
  <article class="group flex gap-4 sm:gap-6 border-b border-border pb-6 last:border-0 last:pb-0">
    <a href={href} class="shrink-0 w-28 sm:w-36 aspect-[4/3] overflow-hidden rounded-xl bg-surface-alt shadow-card">
      {article.image ? (
        <img
          src={article.image}
          alt={article.title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-primary/10 text-primary font-bold text-sm">
          TWG
        </div>
      )}
    </a>
    <div class="flex-1 min-w-0">
      <span class="inline-flex rounded-md bg-accent/10 px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-wider text-accent">
        {category}
      </span>
      <h3 class="mt-2 text-base sm:text-lg font-bold text-text leading-snug group-hover:text-primary transition-colors">
        <a href={href}>{article.title}</a>
      </h3>
      <p class="mt-1.5 text-sm text-text-muted line-clamp-2 hidden sm:block">{article.excerpt}</p>
      <p class="mt-2 text-xs text-text-muted">
        <span class="font-medium">{article.author}</span> · {formatArticleDate(article.date)}
      </p>
    </div>
  </article>
)}

{variant === "compact" && (
  <article class="group">
    <a href={href} class="block">
      <div class="aspect-[16/10] overflow-hidden rounded-lg mb-3">
        {article.image ? (
          <img
            src={article.image}
            alt={article.title}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center bg-primary/10 text-primary font-bold">
            TWG
          </div>
        )}
      </div>
      <span class="text-xs font-semibold uppercase tracking-wide text-accent">{category}</span>
      <h3 class="mt-1 text-sm font-bold text-text leading-snug group-hover:text-primary transition-colors line-clamp-2">
        {article.title}
      </h3>
      <p class="mt-1 text-xs text-text-muted">{formatArticleDate(article.date)}</p>
    </a>
  </article>
)}

{variant === "default" && (
  <article class="group card-lift flex flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-card hover:shadow-card-hover hover:border-primary/25">
    <a href={href} class="block">
      <div class="aspect-[16/10] overflow-hidden bg-surface-alt">
        {article.image ? (
          <img
            src={article.image}
            alt={article.title}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center bg-primary/10 text-primary font-bold text-2xl">
            TWG
          </div>
        )}
      </div>
      <div class="flex flex-1 flex-col p-5">
        <span class="inline-flex self-start rounded-md bg-accent/10 px-2 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-accent">
          {category}
        </span>
        <h3 class="mt-3 text-lg font-bold text-text leading-snug group-hover:text-primary transition-colors line-clamp-2">
          {article.title}
        </h3>
        <p class="mt-2 text-sm text-text-muted line-clamp-3 flex-1">{article.excerpt}</p>
        <div class="mt-4 pt-3 border-t border-border flex items-center justify-between text-xs text-text-muted">
          <span class="font-medium">{article.author}</span>
          <span>{formatArticleDate(article.date)}</span>
        </div>
      </div>
    </a>
  </article>
)}
